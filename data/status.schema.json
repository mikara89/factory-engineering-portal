{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory Engineering public status snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_reviewed",
    "current_development_phase",
    "current_milestone_id",
    "milestones"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "last_reviewed": { "type": "string", "format": "date" },
    "current_development_phase": { "type": "integer", "minimum": 0, "maximum": 7 },
    "current_milestone_id": { "type": "string", "pattern": "^phase-[0-7](a|b)?$" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "summary", "limitations", "evidence_links"],
        "properties": {
          "id": { "type": "string", "pattern": "^phase-[0-7](a|b)?$" },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["Planned", "In progress", "Demonstrated", "Accepted", "Accepted with limitations", "Closed with exception"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "evidence_links": {
            "type": "array",
            "items": { "type": "string", "format": "uri", "pattern": "^https://" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
